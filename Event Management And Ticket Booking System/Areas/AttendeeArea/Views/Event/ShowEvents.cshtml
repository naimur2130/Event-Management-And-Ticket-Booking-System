@model Event_Management_And_Ticket_Booking_System.ViewModel.EventViewModel

@{
    ViewData["Title"] = "Join an Event";
    var cardColors = new[] { "#fef6f6", "#f6f9fe", "#f6fef9", "#fff9f6", "#fdf6ff", "#f6fffb" }; // soft pastel colors
    int colorIndex = 0;
}

<style>
    body {
        font-family: "Segoe UI", sans-serif;
        background: linear-gradient(135deg, #e0f7fa 0%, #ffffff 100%);
        min-height: 100vh;
        padding-bottom: 40px;
    }

    .section-header {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 20px;
        position: relative;
    }

        .section-header::after {
            content: "";
            position: absolute;
            width: 50px;
            height: 3px;
            background: #0d6efd;
            bottom: -5px;
            left: 0;
            border-radius: 2px;
        }

    .event-section {
        margin-bottom: 50px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .event-scroll {
        display: flex;
        overflow-x: auto;
        gap: 20px;
        padding-bottom: 10px;
        scrollbar-width: thin;
        scrollbar-color: #0d6efd #e0f7fa;
    }

        .event-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .event-scroll::-webkit-scrollbar-track {
            background: #e0f7fa;
            border-radius: 10px;
        }

        .event-scroll::-webkit-scrollbar-thumb {
            background-color: #0d6efd;
            border-radius: 10px;
        }

    .event-card {
        flex: 0 0 220px;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .event-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
        }

        .event-card .card-img-top {
            height: 140px;
            object-fit: cover;
        }

        .event-card .card-body {
            padding: 0.75rem;
            font-size: 0.85rem;
            display: flex;
            flex-direction: column;
        }

        .event-card .card-title {
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }

        .event-card .card-text {
            font-size: 0.8rem;
            margin-bottom: 0.5rem;
        }

        .event-card ul {
            margin-bottom: 0.5rem;
        }

        .event-card .chip {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }

    .badge-soft {
        background: rgba(13, 110, 253, 0.15);
        color: #0d6efd;
        font-weight: 500;
        padding: 0.35rem 0.7rem;
        border-radius: 0.5rem;
        font-size: 0.85rem;
    }

    .chip {
        display: inline-block;
        padding: .35rem .6rem;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 600;
    }

    .chip-published {
        background: rgba(25, 135, 84, .12);
        color: #198754;
    }

    .chip-cancelled {
        background: rgba(220, 53, 69, .12);
        color: #dc3545;
    }

    .chip-draft {
        background: rgba(108, 117, 125, .12);
        color: #6c757d;
    }

    .card-footer {
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
        font-size: 0.85rem;
    }

    .event-actions .btn {
        margin-right: 0.35rem;
    }
</style>

<div class="container py-5">

    <div class="event-section">
        <div class="container py-3 mb-4">
            <form method="get" asp-action="ShowEvents" class="row g-2">
                <input type="hidden" name="source" value="Organizer" />

                <div class="col-md-4">
                    <input type="text" name="searchTerm" value="@(Model.Source == "Organizer" ? Model.SearchTerm : "")"
                           placeholder="Search by organizer event name"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <select name="categoryId" class="form-select">
                        <option value="">-- All Categories --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId"
                                    selected="@(Model.Source == "Organizer" && Model.CategoryId == cat.CategoryId)">
                                @cat.CategoryName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Search Organizer Events</button>
                </div>
            </form>
        </div>

        <h3 class="section-header">🎯 Organizer Events</h3>

        @if (!Model.OrganizerEvents.Any())
        {
            <div class="alert alert-info text-center shadow-sm">
                No events created by organizers yet.
            </div>
        }
        else
        {
            <div class="event-scroll">
                @foreach (var item in Model.OrganizerEvents)
                {
                    var bgColor = cardColors[colorIndex % cardColors.Length];
                    colorIndex++;

                    var booking = Model.UserBookings?.FirstOrDefault(b => b.EventId == item.EventId);

                    <div class="card event-card" style="background:@bgColor;">
                        <img src="@(string.IsNullOrEmpty(item.BannerImagePath) ? "~/images/no-image.png" : item.BannerImagePath)"
                             class="card-img-top" alt="@item.Title" />

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@item.Title</h5>
                                <span class="badge badge-soft">@item.EventCategory?.CategoryName ?? "N/A"</span>
                            </div>

                            <p class="card-text text-muted">@item.EventDescription</p>
                            <ul class="list-unstyled small mb-2">
                                <li><i class="bi bi-geo-alt me-1"></i>@item.EventLocation</li>
                                <li><strong>Start:</strong> @item.EventStartUtc:g</li>
                                <li><strong>End:</strong> @item.EventEndUtc:g</li>
                            </ul>

                            @{
                                var statusClass =
                                item.Status == Event_Management_And_Ticket_Booking_System.Models.EventStatus.Published ? "chip chip-published" :
                                item.Status == Event_Management_And_Ticket_Booking_System.Models.EventStatus.Cancelled ? "chip chip-cancelled" :
                                "chip chip-draft";
                            }
                            <div class="mb-2">
                                <span class="@statusClass">@item.Status</span>
                            </div>
                            @if (booking != null)
                            {
                                <div class="mb-2">
                                    @switch (booking.Status)
                                    {

                                        case BookingStatus.Pending:
                                            <form asp-controller="Payment" asp-action="InitiatePayment" method="get">
                                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                <button type="submit" class="btn btn-primary">Pay Now</button>
                                            </form>
                                            break;
                                        case BookingStatus.Confirmed:
                                            <span class="badge bg-success">Payment Completed</span>
                                            
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="badge bg-danger">Booking Cancelled</span>
                                            
                                            break;
                                        case BookingStatus.Failed:
                                            <span class="badge bg-danger">Payment Failed</span>
                                            
                                            break;
                                        
                                    }
                                </div>
                            }
                            <form asp-controller="Booking" asp-action="SelectTickets" method="post" class="mt-auto">
                                <input type="hidden" name="EventId" value="@item.EventId" />
                                <div class="d-flex align-items-center mb-2">
                                    <input type="number" name="Quantity" value="1" min="1" max="10" class="form-control form-control-sm me-2" style="width: 70px;" />
                                    <button type="submit" class="btn btn-success btn-sm flex-shrink-0">Book Now</button>
                                </div>
                            </form>
                        </div>

                        <div class="card-footer text-muted small">
                            Created @item.CreatedAt:g
                        </div>
                    </div>
                }
            </div>
        }
    </div>


    <div class="event-section">

        <div class="container py-3 mb-4">
            <form method="get" asp-action="ShowEvents" class="row g-2">
                <input type="hidden" name="source" value="Attendee" />

                <div class="col-md-4">
                    <input type="text" name="searchTerm" value="@(Model.Source == "Attendee" ? Model.SearchTerm : "")"
                           placeholder="Search by attendee event name"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <select name="categoryId" class="form-select">
                        <option value="">-- All Categories --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId"
                                    selected="@(Model.Source == "Attendee" && Model.CategoryId == cat.CategoryId)">
                                @cat.CategoryName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Search Attendee Events</button>
                </div>
            </form>
        </div>
        <h3 class="section-header">🙋 Attendee Events</h3>

        @if (!Model.AttendeeEvents.Any())
        {
            <div class="alert alert-info text-center shadow-sm">
                No events created by attendees yet.
            </div>
        }
        else
        {
            <div class="event-scroll">
                @foreach (var item in Model.AttendeeEvents)
                {
                    var bgColor = cardColors[colorIndex % cardColors.Length];
                    colorIndex++;

                    // Get current user's booking for this event
                    var booking = Model.UserBookings?.FirstOrDefault(b => b.EventId == item.EventId);

                    <div class="card event-card" style="background:@bgColor;">
                        <img src="@(string.IsNullOrEmpty(item.BannerImagePath) ? "~/images/no-image.png" : item.BannerImagePath)"
                             class="card-img-top" alt="@item.Title" />

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@item.Title</h5>
                                <span class="badge badge-soft">@item.EventCategory?.CategoryName ?? "N/A"</span>
                            </div>

                            <p class="card-text text-muted">@item.EventDescription</p>
                            <ul class="list-unstyled small mb-2">
                                <li><i class="bi bi-geo-alt me-1"></i>@item.EventLocation</li>
                                <li><strong>Start:</strong> @item.EventStartUtc:g</li>
                                <li><strong>End:</strong> @item.EventEndUtc:g</li>
                            </ul>

                            @{
                                var statusClass =
                                item.Status == Event_Management_And_Ticket_Booking_System.Models.EventStatus.Published ? "chip chip-published" :
                                item.Status == Event_Management_And_Ticket_Booking_System.Models.EventStatus.Cancelled ? "chip chip-cancelled" :
                                "chip chip-draft";
                            }
                            <div class="mb-2">
                                <span class="@statusClass">@item.Status</span>
                            </div>

                            <!-- Booking Status / PayNow / Awaiting Approval -->
                            @if (booking != null)
                            {
                                <div class="mb-2">
                                    @switch (booking.Status)
                                    {
                                        case Event_Management_And_Ticket_Booking_System.Models.BookingStatus.Pending:
                                            <span class="badge bg-warning">Awaiting Admin Approval</span>
                                            break;
                                        case Event_Management_And_Ticket_Booking_System.Models.BookingStatus.Confirmed:
                                            <span class="badge bg-success">Payment Completed</span>
                                            break;
                                        case Event_Management_And_Ticket_Booking_System.Models.BookingStatus.Cancelled:
                                            <span class="badge bg-danger">Booking Cancelled</span>
                                            break;
                                        case Event_Management_And_Ticket_Booking_System.Models.BookingStatus.Failed:
                                            <span class="badge bg-danger">Payment Failed</span>
                                            break;
                                        default:
                                            <a asp-area="AttendeeArea" asp-controller="Payment" asp-action="InitiatePayment" asp-route-bookingId="@booking.BookingId" class="btn btn-success btn-sm">Pay Now</a>
                                            break;
                                    }
                                </div>
                            }

                            <form asp-controller="Booking" asp-action="SelectTickets" method="post" class="mt-auto">
                                <input type="hidden" name="EventId" value="@item.EventId" />
                                <div class="d-flex align-items-center mb-2">
                                    <input type="number" name="Quantity" value="1" min="1" max="10" class="form-control form-control-sm me-2" style="width: 70px;" />
                                    <button type="submit" class="btn btn-success btn-sm flex-shrink-0">Book Now</button>
                                </div>
                            </form>
                        </div>

                        <div class="card-footer text-muted small">
                            Created @item.CreatedAt:g
                        </div>
                    </div>
                }
            </div>
        }
    </div>


</div>
