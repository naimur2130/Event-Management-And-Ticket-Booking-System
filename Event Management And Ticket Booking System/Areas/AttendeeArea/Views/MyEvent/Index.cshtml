@model List<Event_Management_And_Ticket_Booking_System.Models.Event>

@{
    ViewData["Title"] = "My Enrolled Events";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">🎟 My Enrolled Events</h2>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <!-- Event Banner -->
                        @if (!string.IsNullOrEmpty(ev.BannerImagePath))
                        {
                            <img src="@ev.BannerImagePath" class="card-img-top" alt="@ev.Title" style="height:200px; object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/images/default-event.jpg" class="card-img-top" alt="No image" style="height:200px; object-fit:cover;" />
                        }

                        <div class="card-body">
                            <h5 class="card-title">@ev.Title</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-geo-alt"></i> @ev.EventLocation
                            </p>
                            <p class="card-text">
                                @ev.EventDescription.Substring(0, Math.Min(ev.EventDescription.Length, 100))...
                            </p>
                            <p class="card-text">
                                <strong>📅</strong> @ev.EventStartUtc.ToString("dd MMM yyyy, hh:mm tt")
                                <br />
                                <strong>💰 Price:</strong> @ev.PricePerTicket.ToString("C")
                            </p>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-between">
                            <a asp-controller="MyEvent" asp-action="MyGallery" asp-route-eventId="@ev.EventId"
                               class="btn btn-sm btn-primary">
                                📷 Photos
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">You haven’t enrolled in any events yet.</p>
            </div>
        }
    </div>
</div>
