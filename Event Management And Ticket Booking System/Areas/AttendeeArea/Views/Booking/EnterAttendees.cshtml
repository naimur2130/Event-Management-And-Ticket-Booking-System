@model Event_Management_And_Ticket_Booking_System.ViewModel.TicketViewModel

@{
    ViewData["Title"] = "Enter Attendees";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <h3 class="mb-4">Booking for @Model.EventTitle</h3>
            <form asp-action="EnterAttendees" method="post">
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="Quantity" />
                <input type="hidden" asp-for="EventTitle" />

                @for (int i = 0; i < Model.Quantity; i++)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            Ticket @(@i + 1)
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Attendee Name</label>
                                <input type="text" name="Attendees[@i].AttendeeName" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="Attendees[@i].AttendeeEmail" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Phone</label>
                                <input type="text" name="Attendees[@i].AttendeePhone" class="form-control" required />
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <a asp-controller="Event" asp-action="ShowEvents" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Confirm Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>
