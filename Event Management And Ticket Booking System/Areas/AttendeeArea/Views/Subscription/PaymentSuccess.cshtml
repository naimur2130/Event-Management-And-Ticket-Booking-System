@model Event_Management_And_Ticket_Booking_System.Models.UserProfile

<div class="container py-5 text-center">
    <div class="card shadow-lg p-5">
        <h2 class="text-success">✅ Subscription Activated!</h2>
        <p class="mt-3">Thank you, <strong>@Model.FullName</strong>. Your subscription is now active.</p>

        <div class="mt-4">
            <p><strong>Subscription Type:</strong> @Model.SubscriptionType</p>
            <p><strong>Amount Paid:</strong> @Model.SubscriptionAmount BDT</p>
            <p><strong>Start Date:</strong> @Model.SubscriptionStart?.ToString("dd MMM yyyy")</p>
            <p><strong>Expiry Date:</strong> @Model.SubscriptionExpiry?.ToString("dd MMM yyyy")</p>
        </div>

        <div class="mt-4">
            <a asp-area="AttendeeArea" asp-controller="UserProfile" asp-action="Profile" class="btn btn-primary">Go to My Profile</a>
            <a asp-area="AttendeeArea" asp-controller="UserProfile" asp-action="Profile" class="btn btn-secondary ms-2">Back to Home</a>
        </div>
    </div>
</div>
