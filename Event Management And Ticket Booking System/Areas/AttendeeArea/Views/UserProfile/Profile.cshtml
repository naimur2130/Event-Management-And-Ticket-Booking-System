@model Event_Management_And_Ticket_Booking_System.Models.UserProfile

<div class="container py-5">
    <h2>My Profile</h2>
    <div class="card shadow p-4">

        <p><strong>User ID:</strong> @Model.UserId</p>
        <p><strong>Email:</strong> @(string.IsNullOrEmpty(Model.Email) ? "Not Provided" : Model.Email)</p>
        <p><strong>Full Name:</strong> @(string.IsNullOrEmpty(Model.FullName) ? "Not Provided" : Model.FullName)</p>
        <p><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "Not Provided" : Model.Phone)</p>
        <p><strong>Address:</strong> @(string.IsNullOrEmpty(Model.Address) ? "Not Provided" : Model.Address)</p>
        <p><strong>City:</strong> @(string.IsNullOrEmpty(Model.City) ? "Not Provided" : Model.City)</p>
        <p><strong>Country:</strong> @(string.IsNullOrEmpty(Model.Country) ? "Not Provided" : Model.Country)</p>

        <p><strong>Subscribed:</strong> @(Model.IsSubscribed ? "Yes" : "No")</p>
        <p><strong>Subscription Type:</strong> @(Model.SubscriptionType.HasValue? Model.SubscriptionType.ToString() : "Not Subscribed")</p>
        <p><strong>Subscription Status:</strong> @Model.SubscriptionStatus</p>
        <p><strong>Subscription Amount:</strong> @(Model.SubscriptionAmount.HasValue? Model.SubscriptionAmount.Value.ToString("C") : "Not Provided")</p>
        <p><strong>Subscription Start:</strong> @(Model.SubscriptionStart.HasValue? Model.SubscriptionStart.Value.ToString("yyyy-MM-dd") : "Not Provided")</p>
        <p><strong>Subscription Expiry:</strong> @(Model.SubscriptionExpiry.HasValue? Model.SubscriptionExpiry.Value.ToString("yyyy-MM-dd") : "Not Provided")</p>

        <div class="mt-3">
            <strong>Profile Image:</strong><br />
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" class="img-thumbnail mt-2" style="max-width:150px;" />
            }
            else
            {
                <span>No Image Uploaded</span>
            }
        </div>

        <div class="mt-4">
            @if (Model.UserProfileId == 0)
            {
                <a asp-action="CreateProfile" class="btn btn-success">Add More Info</a>
            }
            else
            {
                <a asp-action="EditProfile" asp-route-id="@Model.UserProfileId" class="btn btn-primary">Edit Profile</a>
            }
            @if (Model.SubscriptionStatus == Event_Management_And_Ticket_Booking_System.Models.SubscriptionStatus.NonSubscribed
                        || Model.SubscriptionStatus == Event_Management_And_Ticket_Booking_System.Models.SubscriptionStatus.Expired)
            {
                <a asp-controller="Subscription" asp-action="Subscribe" asp-route-id="@Model.UserProfileId" class="btn btn-warning ml-2">Get a Subscription</a>
            }
            else
            {
                <span class="badge bg-success">Subscribed: @Model.SubscriptionType</span>
                <br />
                <span><strong>Expires:</strong> @Model.SubscriptionExpiry?.ToString("yyyy-MM-dd")</span>
            }
        </div>
    </div>
</div>
